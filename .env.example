# ContextSlim AI - example configuration
# Copy this file to `.env` and fill in your own values.
# `.env` is git-ignored: never commit real keys.

# --- Deep mode ----------------------------------------------------------------
# Which model backend deep mode uses: "gemini" (default) or "anthropic".
# Slim mode needs none of this and is always available.
CONTEXTSLIM_DEEP_PROVIDER=gemini

# Key for the provider you selected above. Set only the one you use.
# Without it, deep mode falls back to slim and tells you why. Nothing breaks.
GEMINI_API_KEY=
# ANTHROPIC_API_KEY=

# Model per provider. Change these if a newer model is available.
# Google retires older model ids for new keys; if a call returns 404 the error
# names the replacement, and changing it here is the whole fix.
CONTEXTSLIM_GEMINI_MODEL=gemini-3.6-flash
CONTEXTSLIM_ANTHROPIC_MODEL=claude-haiku-4-5

# Max tokens the model may spend producing a capsule.
CONTEXTSLIM_DEEP_MAX_TOKENS=2000
# Safety rail from the risk register: cap deep calls per minute.
CONTEXTSLIM_DEEP_RATE_LIMIT_PER_MINUTE=20

# Transient upstream failures (503 "high demand", 429) are retried with
# exponential backoff before falling back to slim. Permanent errors such as a
# bad key or a retired model are never retried.
CONTEXTSLIM_DEEP_MAX_ATTEMPTS=3
CONTEXTSLIM_DEEP_RETRY_BACKOFF_SECONDS=1.0

# --- Storage ------------------------------------------------------------------
# Leave blank to use the OS-standard per-user data directory:
#   macOS   ~/Library/Application Support/contextslim
#   Linux   ~/.local/share/contextslim
#   Windows %LOCALAPPDATA%\ContextSlim\contextslim
# CONTEXTSLIM_HOME=
# CONTEXTSLIM_DB_PATH=
# CONTEXTSLIM_EXPORT_DIR=

# --- Compression --------------------------------------------------------------
# Sentences sumy keeps per capsule in slim mode.
CONTEXTSLIM_SLIM_SENTENCES=14
# tiktoken encoding used for approximate token counts.
CONTEXTSLIM_TOKEN_ENCODING=cl100k_base

# --- Context health thresholds ------------------------------------------------
CONTEXTSLIM_HEALTH_WARNING_TOKENS=60000
CONTEXTSLIM_HEALTH_CRITICAL_TOKENS=80000
CONTEXTSLIM_CONTEXT_WINDOW_TOKENS=200000

# --- Ingestion ----------------------------------------------------------------
# Largest single file accepted by the multi-format processor, in megabytes.
CONTEXTSLIM_MAX_FILE_MB=25

# --- Logging ------------------------------------------------------------------
# Logs go to stderr only; stdout is reserved for the MCP JSON-RPC channel.
CONTEXTSLIM_LOG_LEVEL=INFO
